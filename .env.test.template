# Test Environment Template
# Copy this to .env.test and configure for your environment

# ============================================================================
# Test Environment Configuration
# ============================================================================

# Environment: local, staging, or production
TEST_ENV=local

# ============================================================================
# Database Configuration
# ============================================================================

# Database type: sqlite or postgresql
TEST_DB_TYPE=sqlite

# Database URL
# SQLite (default for local testing):
TEST_DATABASE_URL=sqlite:///./test.db

# PostgreSQL (for staging/production):
# TEST_DATABASE_URL=postgresql://user:password@host:5432/kabala_test

# ============================================================================
# API Configuration
# ============================================================================

# API base URL for integration tests
TEST_API_URL=http://localhost:8000

# ============================================================================
# Feature Flags
# ============================================================================

# Include slow tests in test runs (default: false)
TEST_RUN_SLOW=false

# Include OCR tests in test runs (default: false)
TEST_RUN_OCR=false

# Use Cloudinary in tests (default: false)
TEST_USE_CLOUDINARY=false

# ============================================================================
# Logging
# ============================================================================

# Log level for tests: DEBUG, INFO, WARNING, ERROR, CRITICAL
TEST_LOG_LEVEL=INFO

# ============================================================================
# Cloudinary Configuration (if TEST_USE_CLOUDINARY=true)
# ============================================================================

# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ============================================================================
# Production Configuration Examples
# ============================================================================

# For testing against staging:
# TEST_ENV=staging
# TEST_API_URL=https://staging-api.example.com
# TEST_DATABASE_URL=postgresql://user:password@staging-db.example.com/kabala_test
# TEST_USE_CLOUDINARY=true
# CLOUDINARY_URL=cloudinary://staging_key:staging_secret@cloud_name

# For testing against production (use with caution!):
# TEST_ENV=production
# TEST_API_URL=https://api.example.com
# TEST_DATABASE_URL=postgresql://user:password@prod-db.example.com/kabala_test
# TEST_USE_CLOUDINARY=true
# CLOUDINARY_URL=cloudinary://prod_key:prod_secret@cloud_name
