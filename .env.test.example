# Test Environment Configuration
# Copy this to .env.test and customize for your testing setup

# ============================================================================
# Test Environment
# ============================================================================
TEST_ENV=local
TEST_LOG_LEVEL=INFO

# ============================================================================
# Database Configuration
# ============================================================================
# Use SQLite for local testing (recommended)
TEST_DB_TYPE=sqlite
TEST_DATABASE_URL=sqlite:///./test.db

# For PostgreSQL testing (optional):
# TEST_DB_TYPE=postgresql
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/kabala_test

# ============================================================================
# API Configuration
# ============================================================================
TEST_API_URL=http://localhost:8000

# ============================================================================
# Email Service Configuration
# ============================================================================

# Resend API Key (REQUIRED for email tests)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Domain (for production, use your verified domain)
# For now, use Resend's test domain (resend.dev)
EMAIL_DOMAIN=resend.dev
CLAIMS_FROM_EMAIL=onboarding@resend.dev

# ============================================================================
# Email Test Mode Configuration
# ============================================================================

# Enable test mode (redirects emails to TEST_EMAIL_RECIPIENT)
# Set to 'false' to use actual email sending (requires verified domain)
EMAIL_TEST_MODE=true

# IMPORTANT: Provide YOUR email address here to receive test emails
# The system will redirect all outbound claim emails to this address
# You'll see original recipients in the email subject
# Example: [TO: claims@insurance.com] [CC: user@example.com] Claim Subject
TEST_EMAIL_RECIPIENT=your-email@example.com

# Resend Webhook Secret (optional for webhook tests)
# Get from: https://resend.com/webhooks after creating webhook
RESEND_WEBHOOK_SECRET=whsec_test_your_secret_here

# ============================================================================
# Optional Feature Toggles
# ============================================================================

# Run slow tests (OCR, external services)
TEST_RUN_SLOW=false

# Test OCR functionality
TEST_RUN_OCR=false

# Use Cloudinary in tests
TEST_USE_CLOUDINARY=false

# ============================================================================
# Optional: Cloudinary Configuration (if TEST_USE_CLOUDINARY=true)
# ============================================================================
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ============================================================================
# Notes
# ============================================================================
# 1. TEST_EMAIL_RECIPIENT is crucial for end-to-end email testing
#    Set this to your own email to receive test emails
#
# 2. RESEND_API_KEY is required for actual Resend API calls
#    Mock tests work without it, but live tests need it
#
# 3. In test mode, emails are redirected but still sent through Resend
#    This allows verifying email content without having a verified domain
#
# 4. When EMAIL_TEST_MODE=false, you must have a verified domain
#    and the CLAIMS_FROM_EMAIL address must be on that domain
#
# 5. For webhook testing, create a webhook in Resend dashboard:
#    - URL: http://localhost:8000/webhooks/email-inbound
#    - Events: email_received
#    - Copy the webhook secret to RESEND_WEBHOOK_SECRET
